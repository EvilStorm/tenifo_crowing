	//선택항목 삭제
	function fnChooseDel(val){
		if (val=='none'){
			$('.choose_sch .radio_item ').remove();
			$('#sch_reqst_value').prop('checked',true);
		} else if (val=='prior'){
			// 선택항목에서 삭제
			$('.choose_sch .radio_item1').remove();
			// 검색조건에서 선택 해제, 아니오 설정
			$('#svc_prior_N').prop('checked',true);
		} else {
			var str = '.choose_sch .'+val;
			$(str).remove();

			var str2 = '#'+val;
			$(str2).prop("checked",false);

			if(val=='sch_recpt_dt'){
				$( '[name=sch_recpt_begin_dt]' ).val('');
				$( '[name=sch_recpt_end_dt]' ).val('');
			}else if(val =='sch_use_dt'){
				$( '[name=sch_use_begin_dt]' ).val('');
				$( '[name=sch_use_end_dt]' ).val('');

			}
		}

		document.getElementById('dl_focus').focus();
	}

